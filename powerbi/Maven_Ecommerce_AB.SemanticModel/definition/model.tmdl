model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["experiment_primary_metric","experiment_guardrail_metrics","experiment_diagnostic_metrics","experiment_srm_check","experiment_balance_summary","experiment_user_crossover_check","experiment_exposure_audit"]

annotation PBI_ProTooling = ["DevMode"]

ref table experiment_primary_metric
ref table experiment_guardrail_metrics
ref table experiment_diagnostic_metrics
ref table experiment_srm_check
ref table experiment_balance_summary
ref table experiment_user_crossover_check
ref table experiment_exposure_audit

ref cultureInfo en-US

