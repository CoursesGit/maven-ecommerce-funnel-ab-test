table quarterly_metrics
	lineageTag: 584bc213-4dd7-405b-93e7-8a981cfbab93

	column quarter_start
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 32ce76e8-3cee-4ea8-b2d9-91e489be5a8a
		summarizeBy: none
		sourceColumn: quarter_start

	column year_quarter
		dataType: string
		lineageTag: 8012b623-4c53-4554-929b-850098caa814
		summarizeBy: none
		sourceColumn: year_quarter
		sortByColumn: quarter_start

	column sessions
		dataType: int64
		formatString: 0
		lineageTag: 22552c8d-4fc7-4559-9863-87401115474b
		summarizeBy: sum
		sourceColumn: sessions

	column purchasing_sessions
		dataType: int64
		formatString: 0
		lineageTag: f50dc18b-afe6-46b1-9b1c-73c00fdfee83
		summarizeBy: sum
		sourceColumn: purchasing_sessions

	column orders
		dataType: int64
		formatString: 0
