	column revenue
		dataType: double
		formatString: $#,##0.00
		lineageTag: 8306cca0-5801-49d6-b407-eee1c35e8091
		summarizeBy: sum
		sourceColumn: revenue

	column revenue_per_session
		dataType: double
		formatString: $#,##0.00
		lineageTag: b92ee46e-0d26-455a-ab73-d1c7a966221c
		summarizeBy: sum
		sourceColumn: revenue_per_session

	partition quarterly_metrics = m
