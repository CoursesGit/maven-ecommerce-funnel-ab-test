	measure 'Absolute Lift Display' = FORMAT(MAX(ab_test_summary[absolute_lift]) * 100, "+0.00;-0.00") & " pp"
		lineageTag: 38aa64b6-8ad0-433a-bc7a-84f4a6367f49

