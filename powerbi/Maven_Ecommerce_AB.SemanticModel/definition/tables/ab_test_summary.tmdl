		lineageTag: c48d2d55-e421-40e0-b51d-1782422e9255

	measure 'P-value Display' = IF(MAX(ab_test_summary[p_value]) < 0.001, "< 0.001", FORMAT(MAX(ab_test_summary[p_value]), "0.000"))
