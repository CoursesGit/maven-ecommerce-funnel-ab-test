	measure '95% CI Display' = FORMAT(MAX(ab_test_summary[ci_lower]) * 100, "+0.00;-0.00") & " pp ～ " & FORMAT(MAX(ab_test_summary[ci_upper]) * 100, "+0.00;-0.00") & " pp"
